/* ---------- "why" calculator: scale bars, RAM meter ---------- */
.calc .x-scale{margin-top:26px}
.x-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:14px;color:var(--muted);margin-bottom:12px;flex-wrap:wrap}
.x-head strong{font-family:var(--font-mono);font-size:18px;font-weight:500;color:var(--text);transition:color .3s}
.x-hint{font-size:12px;color:var(--faint)}
.x-row{display:grid;grid-template-columns:1fr auto;gap:6px 12px;margin-bottom:14px}
.x-lab{font-size:14px;color:var(--muted)}
.x-val{font-family:var(--font-mono);font-size:15px;font-variant-numeric:tabular-nums}
.x-nary .x-val{color:var(--cyan)}.x-pair .x-val{color:var(--magenta)}
.x-track{grid-column:1 / -1;position:relative;height:10px;border-radius:99px;background:var(--surface-2);overflow:hidden}
.x-bar{position:absolute;left:0;top:0;bottom:0;border-radius:99px;min-width:4px;transition:width .35s var(--md-ease-out)}
.x-nary .x-bar{width:4px;background:var(--brand-cyan);box-shadow:0 0 10px var(--brand-cyan)}
.x-pair .x-bar{background:linear-gradient(90deg,var(--brand-violet),var(--brand-pink))}
.x-pair .x-track.over .x-bar{-webkit-mask-image:linear-gradient(90deg,#000 80%,transparent);mask-image:linear-gradient(90deg,#000 80%,transparent)}
.x-run{position:absolute;right:6px;top:50%;translate:0 -50%;font-size:12px;line-height:1;color:var(--text);opacity:0;transition:opacity .3s}
.x-track.over .x-run{opacity:.9;animation:x-run 1.2s ease-in-out infinite}
@keyframes x-run{50%{transform:translateX(3px)}}
.x-note{font-size:13.5px;color:var(--muted);margin-top:-2px;min-height:1.6em}
.x-note strong{color:var(--text);font-weight:600}
.calc .x-mem{margin-top:22px}
.x-mtrack{position:relative;height:12px;margin:30px 0 34px;border-radius:99px;background:var(--surface-2)}
.x-mfill{position:absolute;left:0;top:0;bottom:0;border-radius:99px;min-width:6px;background:var(--green);transition:width .35s var(--md-ease-out),background-color .35s}
.x-mk{font-style:normal;position:absolute;top:-5px;bottom:-5px;width:2px;margin-left:-1px;background:var(--faint);border-radius:2px;left:var(--p)}
.x-mk b{position:absolute;left:50%;translate:-50% 0;white-space:nowrap;text-align:center;font-family:var(--font-mono);font-weight:400;font-size:10.5px;line-height:1.3;color:var(--faint);transition:color .3s}
.x-mk.x-dn b{top:calc(100% + 5px)}.x-mk.x-up b{bottom:calc(100% + 5px)}
.x-mk.hit{background:var(--text)}.x-mk.hit b{color:var(--text)}
.x-memfoot{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}
.x-chip{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:500;padding:4px 12px;border-radius:999px;border:1px solid currentColor;color:var(--green);background:color-mix(in srgb,currentColor 12%,transparent)}
.x-chip:before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.x-chip[data-l="1"]{color:var(--orange)}.x-chip[data-l="2"],.x-chip[data-l="3"]{color:var(--magenta)}
.x-mnote{font-size:13px;color:var(--faint)}
.x-fold{margin-top:22px!important}
.x-fold strong{display:inline-block;font-variant-numeric:tabular-nums;transform-origin:left center}
.x-fold strong.pulse{animation:x-pulse .6s var(--md-ease-out)}
.x-chip.pulse{animation:x-pulse .6s var(--md-ease-out),x-ring .9s ease-out}
@keyframes x-pulse{30%{transform:scale(1.12)}}
@media(min-width:961px){.compare{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)!important}}
.viz figcaption{min-height:1.4em}
@media(max-width:640px){.x-mk b{font-size:9.5px}.x-mtrack{margin:28px 6px 32px}}
@media(prefers-reduced-motion:reduce){.x-fold strong.pulse,.x-chip.pulse,.x-track.over .x-run{animation:none}}

/* balance the "why" card: compact right column, larger stacked visuals on desktop */
.calc h3{margin-bottom:14px!important}
.calc .x-scale{margin-top:18px}
