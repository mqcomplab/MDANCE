electorAll(".chip"),n=document.querySelectorAll(".algo");l.forEach(e=>e.addEventListener("click",()=>{const s=e.dataset.filter;l.forEach(t=>{const o=t===e;t.classList.toggle("active",o),t.setAttribute("aria-pressed",String(o))}),n.forEach(t=>{const o=s==="all"||t.dataset.cat===s;t.classList.toggle("hidden",!o),o&&t.classList.add("in")})}));n.forEach(e=>e.addEventListener("pointermove",s=>{const t=e.getBoundingClientRect();e.style.setProperty("--mx",`${s.clientX-t.left}px`),e.style.setProperty("--my",`${s.clientY-t.top}px`)}));</script> <section class="aud" data-astro-cid-z2nwgh7l> <div class="container" data-astro-cid-z2nwgh7l> <div data-reveal data-astro-cid-z2nwgh7l> <span class="eyebrow" data-astro-cid-z2nwgh7l>Built for you</span> <h2 class="section-title" data-astro-cid-z2nwgh7l>Whoever runs your trajectories, <span class="gradient-text" data-astro-cid-z2nwgh7l>MDANCE fits in.</span></h2> </div> <div class="grid" data-astro-cid-z2nwgh7l> <div class="card who" style="--accent:var(--cyan); --delay:0s" data-reveal data-astro-cid-z2nwgh7l> <div class="w-head"><span class="icon" aria-hidden="true" data-astro-cid-z2nwgh7l>⚛️</span> <h3 data-astro-cid-z2nwgh7l>Computational chemists</h3></div> <p data-astro-cid-z2nwgh7l>Drop the N×N RMSD matrix. Cluster full-length trajectories on a laptop or a single node, with results you can reproduce.</p> </div><div class="card who" style="--accent:var(--magenta); --delay:0.07s" data-reveal data-astro-cid-z2nwgh7l> <div class="w-head"><span class="icon" aria-hidden="true" data-astro-cid-z2nwgh7l>🧬</span> <h3 data-astro-cid-z2nwgh7l>Structural biologists</h3></div> <p data-astro-cid-z2nwgh7l>Go from simulations to biology: dominant transition pathways, metastable states, and native structures that match experiment.</p> </div><div class="card who" style="--accent:var(--orange); --delay:0.14s" data-reveal data-astro-cid-z2nwgh7l> <div class="w-head"><span class="icon" aria-hidden="true" data-astro-cid-z2nwgh7l>💊</span> <h3 data-astro-cid-z2nwgh7l>Pharma &amp; industry</h3></div> <p data-astro-cid-z2nwgh7l>Screen conformational ensembles at scale. Linear cost and deterministic output fit production pipelines and audits.</p> </div><div class="card who" style="--accent:var(--violet); --delay:0.21000000000000002s" data-reveal data-astro-cid-z2nwgh7l> <div class="w-head"><span class="icon" aria-hidden="true" data-astro-cid-z2nwgh7l>🎓</span> <h3 data-astro-cid-z2nwgh7l>Students &amp; newcomers</h3></div> <p data-astro-cid-z2nwgh7l>Learn modern MD analysis with step-by-step tutorials and notebooks.</p> <a class="algos" href="https://mdance.readthedocs.io/en/latest/nani-in-60-seconds.html" target="_blank" rel="noopener" data-astro-cid-z2nwgh7l>Start with NANI →</a> </div> </div> </div> </section>  <section id="quickstart" class="qs" data-astro-cid-d3yughyh> <div class="container grid" data-astro-cid-d3yughyh> <div data-reveal data-astro-cid-d3yughyh> <span class="eyebrow" data-astro-cid-d3yughyh>Quick start</span> <h2 class="section-title" data-astro-cid-d3yughyh>From <code class="inline" data-astro-cid-d3yughyh>pip install</code> to clusters in <span class="gradient-text" data-astro-cid-d3yughyh>60 seconds.</span></h2> <ol class="steps" data-astro-cid-d3yughyh> <li data-astro-cid-d3yughyh> <span class="n" data-astro-cid-d3yughyh>01</span> <div data-astro-cid-d3yughyh><h3 data-astro-cid-d3yughyh>Install from PyPI</h3><p data-astro-cid-d3yughyh>One command. Pure Python, built on NumPy, scikit-learn and MDAnalysis.</p></div> </li><li data-astro-cid-d3yughyh> <span class="n" data-astro-cid-d3yughyh>02</span> <div data-astro-cid-d3yughyh><h3 data-astro-cid-d3yughyh>Load your trajectory</h3><p data-astro-cid-d3yughyh>Read AMBER, GROMACS or CHARMM output through MDAnalysis, or bring a NumPy array.</p></div> </li><li data-astro-cid-d3yughyh> <span class="n" data-astro-cid-d3yughyh>03</span> <div data-astro-cid-d3yughyh><h3 data-astro-cid-d3yughyh>Pick an algorithm</h3><p data-astro-cid-d3yughyh>Start with NANI, then go further with HELM, DIVINE, SHINE or PRIME.</p></div> </li> </ol> <div class="more" data-astro-cid-d3yughyh> <a class="btn btn-primary" href="https://mdance.readthedocs.io/en/latest/nani-in-60-seconds.html" target="_blank" rel="noopener" data-astro-cid-d3yughyh>Learn NANI in 60 seconds →</a> <a class="btn" href="https://mdance.readthedocs.io/en/latest/" target="_blank" rel="noopener" data-astro-cid-d3yughyh>All tutorials</a> </div> </div> <div class="window" data-reveal style="--delay:.1s" data-astro-cid-d3yughyh> <div class="bar" data-astro-cid-d3yughyh> <span class="lights" data-astro-cid-d3yughyh><i data-astro-cid-d3yughyh></i><i data-astro-cid-d3yughyh></i><i data-astro-cid-d3yughyh></i></span> <div class="tabs" role="tablist" data-astro-cid-d3yughyh> <button role="tab" class="tab" data-tab="install" aria-selected="false" data-astro-cid-d3yughyh>Install</button><button role="tab" class="tab active" data-tab="nani" aria-selected="true" data-astro-cid-d3yughyh>Cluster with NANI</button> </div> </div> <div class="panel" data-panel="install" role="tabpanel" data-astro-cid-d3yughyh> <button class="copy-btn" data-copy="pip install mdance

# verify
python -c &#34;import mdance; print(mdance.__version__)&#34;" data-astro-cid-d3yughyh>Copy</button> <pre class="astro-code github-dark-default" style="background-color:#0b1026;color:#e6edf3; overflow-x: auto;" tabindex="0" data-astro-cid-d3yughyh data-language="bash"><code><span class="line"><span style="color:#FFA657">pip</span><span style="color:#A5D6FF"> install</span><span style="color:#A5D6FF"> mdance</span></span>
<span class="line"></span>
<span class="line"><span style="color:#8B949E"># verify</span></span>
<span class="line"><span style="color:#FFA657">python</span><span style="color:#79C0FF"> -c</span><span style="color:#A5D6FF"> "import mdance; print(mdance.__version__)"</span></span></code></pre> </div><div class="panel active" data-panel="nani" role="tabpanel" data-astro-cid-d3yughyh> <button class="copy-btn" data-copy="import numpy as np
from sklearn.cluster import KMeans
from mdance import data
from mdance.cluster.nani import KmeansNANI

# Example trajectory: 6,001 frames x 50 backbone atoms
X = np.load(data.sim_traj_numpy)

# Deterministic NANI seeding: no random starts
nani = KmeansNANI(data=X, n_clusters=6, metric='MSD',
                  N_atoms=50, init_type='strat_reduced',
                  percentage=10)
centroids = nani.initiate_kmeans()

# k-means from NANI's seeds: same labels every run
labels = KMeans(n_clusters=6, init=centroids,
                n_init=1).fit(X).labels_" data-astro-cid-d3yughyh>Copy</button> <pre class="astro-code github-dark-default" style="background-color:#0b1026;color:#e6edf3; overflow-x: auto;" tabindex="0" data-astro-cid-d3yughyh data-language="python"><code><span class="line"><span style="color:#FF7B72">import</span><span style="color:#E6EDF3"> numpy </span><span style="color:#FF7B72">as</span><span style="color:#E6EDF3"> np</span></span>
<span class="line"><span style="color:#FF7B72">from</span><span style="color:#E6EDF3"> sklearn.cluster </span><span style="color:#FF7B72">import</span><span style="color:#E6EDF3"> KMeans</span></span>
<span class="line"><span style="color:#FF7B72">from</span><span style="color:#E6EDF3"> mdance </span><span style="color:#FF7B72">import</span><span style="color:#E6EDF3"> data</span></span>
<span class="line"><span style="color:#FF7B72">from</span><span style="color:#E6EDF3"> mdance.cluster.nani </span><span style="color:#FF7B72">import</span><span style="color:#E6EDF3"> KmeansNANI</span></span>
<span class="line"></span>
<span class="line"><span style="color:#8B949E"># Example trajectory: 6,001 frames x 50 backbone atoms</span></span>
<span class="line"><span style="color:#E6EDF3">X </span><span style="color:#FF7B72">=</span><span style="color:#E6EDF3"> np.load(data.sim_traj_numpy)</span></span>
<span class="line"></span>
<span class="line"><span style="color:#8B949E"># Deterministic NANI seeding: no random starts</span></span>
<span class="line"><span style="color:#E6EDF3">nani </span><span style="color:#FF7B72">=</span><span style="color:#E6EDF3"> KmeansNANI(</span><span style="color:#FFA657">data</span><span style="color:#FF7B72">=</span><span style="color:#E6EDF3">X</span><span style="color:#E6EDF3">, </span><span style="color:#FFA657">n_clusters</span><span style="color:#FF7B72">=</span><span style="color:#79C0FF">6</span><span style="color:#E6EDF3">, </span><span style="color:#FFA657">metric</span><span style="color:#FF7B72">=</span><span style="color:#A5D6FF">'MSD'</span><span style="color:#E6EDF3">,</span></span>
<span class="line"><span style="color:#E6EDF3">                  </span><span style="color:#FFA657">N_atoms</span><span style="color:#FF7B72">=</span><span style="color:#79C0FF">50</span><span style="color:#E6EDF3">, </span><span style="color:#FFA657">init_type</span><span style="color:#FF7B72">=</span><span style="color:#A5D6FF">'strat_reduced'</span><span style="color:#E6EDF3">,</span></span>
<span class="line"><span style="color:#E6EDF3">                  </span><span style="color:#FFA657">percentage</span><span style="color:#FF7B72">=</span><span style="color:#79C0FF">10</span><span style="color:#E6EDF3">)</span></span>
<span class="line"><span style="color:#E6EDF3">centroids </span><span style="color:#FF7B72">=</span><span style="color:#E6EDF3"> nani.initiate_kmeans()</span></span>
<span class="line"></span>
<span class="line"><span style="color:#8B949E"># k-means from NANI's seeds: same labels every run</span></span>
<span class="line"><span style="color:#E6EDF3">labels </span><span style="color:#FF7B72">=</span><span style="color:#E6EDF3"> KMeans(</span><span style="color:#FFA657">n_clusters</span><span style="color:#FF7B72">=</span><span style="color:#79C0FF">6</span><span style="color:#E6EDF3">, </span><span style="color:#FFA657">init</span><span style="color:#FF7B72">=</span><span style="color:#E6EDF3">centroids</span><span style="color:#E6EDF3">,</span></span>
<span class="line"><span style="color:#E6EDF3">                </span><span style="color:#FFA657">n_init</span><span style="color:#FF7B72">=</span><span style="color:#79C0FF">1</span><span style="color:#E6EDF3">).fit(X).labels_</span></span></code></pre> </div> </div> </div> </section>  <script is:inline type="module">const c=document.querySelectorAll(".tab"),s=document.querySelectorAll(".panel");c.forEach(t=>t.addEventListener("click",()=>{c.forEach(e=>{const a=e===t;e.classList.toggle("active",a),e.setAttribute("aria-selected",String(a))}),s.forEach(e=>e.classList.toggle("active",e.dataset.panel===t.dataset.tab))}));</script> <section id="papers" class="papers" data-astro-cid-u7el4rif> <div class="container grid" data-astro-cid-u7el4rif> <div data-reveal data-astro-cid-u7el4rif> <span class="eyebrow" data-astro-cid-u7el4rif>Peer reviewed</span> <h2 class="section-title" data-astro-cid-u7el4rif>References</h2> <p class="section-lead" data-astro-cid-u7el4rif>Each algorithm in MDANCE is described and validated in its own paper.</p> <div class="cite card" data-astro-cid-u7el4rif> <div class="cite-head" data-astro-cid-u7el4rif> <h3 data-astro-cid-u7el4rif>Using MDANCE? Please cite us.</h3> <button class="copy-btn" data-copy="@article&#123;chen_k-means_2024,
