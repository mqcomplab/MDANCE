/* ---------- nav logo: tile wave, once on load (brand motion tokens) ---------- */
@keyframes md-tile-in{from{opacity:0;transform:translateY(-14%) scale(.55)}to{opacity:1;transform:none}}
@keyframes md-light{from{fill:#1E2650}to{fill:#FFD147}}
@keyframes md-light-w{from{fill:#E3E6F2}to{fill:#FFD147}}
@keyframes md-glow{0%{filter:drop-shadow(0 0 0 rgba(255,209,71,0))}35%{filter:drop-shadow(0 0 7px rgba(255,209,71,.4))}100%{filter:drop-shadow(0 0 0 rgba(255,209,71,0))}}
.logo-anim .t{transform-box:fill-box;transform-origin:50% 50%;animation:md-tile-in 300ms var(--md-ease-out) both;animation-delay:calc(var(--i) * 60ms)}
.logo-anim .t-hi{animation:md-tile-in 300ms var(--md-ease-out) both,md-light 300ms var(--md-ease-out) both,md-glow 700ms ease-out both;animation-delay:calc(var(--i) * 60ms),900ms,900ms}
:root[data-theme=light] .logo-anim .t-hi{animation-name:md-tile-in,md-light-w,md-glow}
@media(prefers-reduced-motion:reduce){.logo-anim .t,.logo-anim .t-hi{animation:none!important}}

