/* calmer colour system for the calculator: warm = pairwise cost, cyan = n-ary, neutral controls */
input[type=range]#frames{accent-color:var(--brand-violet)}
.x-pair .x-bar{background:linear-gradient(90deg,var(--brand-violet),var(--brand-pink))!important}
.x-head strong{color:var(--magenta)!important}
