.theme-toggle{background:none;border:0;padding:0;width:36px;height:36px;border-radius:10px;cursor:pointer;color:var(--muted);display:grid;place-items:center;transition:color .2s ease,background-color .2s ease,transform .14s cubic-bezier(.23,1,.32,1)}
.theme-toggle:hover{color:var(--text);background:rgba(127,127,127,.12)}
.theme-toggle:active{transform:scale(.94)}
.theme-toggle:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.theme-toggle .sun{display:none}
:root[data-theme=light] .theme-toggle .sun{display:block}
:root[data-theme=light] .theme-toggle .moon{display:none}

/* ---------- responsive / phone polish ---------- */
.menu-btn{display:none;background:none;border:0;padding:0;width:40px;height:40px;border-radius:10px;cursor:pointer;color:var(--text);place-items:center}
.menu-btn:hover{background:rgba(127,127,127,.12)}
.menu-btn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.menu-btn path{transition:transform .25s ease,opacity .2s ease;transform-origin:12px 12px}
.nav.open .menu-btn .l1{transform:translateY(5px) rotate(45deg)}
.nav.open .menu-btn .l2{opacity:0}
.nav.open .menu-btn .l3{transform:translateY(-5px) rotate(-45deg)}
.mobile-menu{border-top:1px solid var(--border);padding:8px 0 20px;max-height:calc(100svh - 68px);overflow-y:auto}
.mobile-menu[hidden]{display:none}
.mobile-menu a:not(.btn){display:block;padding:14px 2px;font-family:var(--font-display);font-size:20px;font-weight:500;color:var(--text);border-bottom:1px solid var(--border)}
.mm-actions{display:flex;gap:12px;margin-top:20px}
.mm-actions .btn{flex:1;justify-content:center}
.nav.open{background:var(--bg)!important;border-color:var(--border)}
.nav{padding-top:env(safe-area-inset-top,0px)}
.container{padding-left:max(24px,env(safe-area-inset-left,0px));padding-right:max(24px,env(safe-area-inset-right,0px))}
input[type=range]{touch-action:pan-y}
