/* ===== UX pass: touch + desktop ===== */
/* 1. slider: bigger thumb, filled track, tappable size markers */
input#frames{-webkit-appearance:none;appearance:none;width:100%;height:32px;margin:8px 0 0;background:transparent;cursor:pointer;touch-action:pan-y}
input#frames::-webkit-slider-runnable-track{height:6px;border-radius:99px;background:linear-gradient(90deg,var(--brand-violet) 0,var(--brand-violet) var(--fill,50%),var(--surface-2) var(--fill,50%))}
input#frames::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;margin-top:-8px;border-radius:50%;background:#fff;border:3px solid var(--brand-violet);box-shadow:0 2px 8px rgba(11,16,38,.35);transition:transform .15s}
input#frames:active::-webkit-slider-thumb{transform:scale(1.12)}
input#frames::-moz-range-track{height:6px;border-radius:99px;background:var(--surface-2)}
input#frames::-moz-range-progress{height:6px;border-radius:99px;background:var(--brand-violet)}
input#frames::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:#fff;border:3px solid var(--brand-violet);box-shadow:0 2px 8px rgba(11,16,38,.35)}
input#frames:focus-visible{outline:none}
input#frames:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 5px color-mix(in srgb,var(--brand-violet) 35%,transparent)}
input#frames:focus-visible::-moz-range-thumb{box-shadow:0 0 0 5px color-mix(in srgb,var(--brand-violet) 35%,transparent)}
:root[data-theme=light] input#frames::-webkit-slider-runnable-track{background:linear-gradient(90deg,var(--brand-violet) 0,var(--brand-violet) var(--fill,50%),#e3e5f2 var(--fill,50%))}
.x-ticks{position:relative;height:30px;margin:0 0 4px}
.x-ticks button{position:absolute;top:0;left:calc(11px + var(--p) * (100% - 22px));transform:translateX(-50%);background:none;border:0;padding:6px 6px;font-family:var(--font-mono);font-size:11px;color:var(--faint);cursor:pointer;border-radius:6px;line-height:1}
.x-ticks button:first-child{transform:translateX(-11px)}.x-ticks button:last-child{transform:translateX(calc(-100% + 11px))}
.x-ticks button:hover{color:var(--text);background:var(--surface-2)}
@media(pointer:coarse){
  input#frames{height:44px}
  input#frames::-webkit-slider-thumb{width:30px;height:30px;margin-top:-12px}
  input#frames::-moz-range-thumb{width:26px;height:26px}
  .x-ticks{height:36px}.x-ticks button{padding:10px 8px;font-size:12px}
  /* 2. bigger tap targets */
  #algo-grid .algo .links a{display:inline-flex;align-items:center;min-height:44px;padding:0 2px}
  .copy-btn{min-height:36px;min-width:56px}
  .chip{min-height:44px}
  .footer a{display:inline-block;padding:7px 0}
  .tab{min-height:44px}
}
/* 3. nav hides while scrolling down (phones + tablets) */
@media(max-width:1000px){
  .nav{transition:transform .32s var(--md-ease-out),background .3s ease,border-color .3s ease!important}
  .nav.nav-hide{transform:translateY(-100%)}
}
/* 4. code blocks: fade on the right when there's more to scroll */
.panel{position:relative}
.panel::after{content:"";position:absolute;top:0;right:0;bottom:0;width:44px;background:linear-gradient(90deg,transparent,#0b1026);pointer-events:none;opacity:0;transition:opacity .25s}
.panel.more::after{opacity:1}
/* 5. current section in the nav */
.links[data-astro-cid-dmqpwcec] a{position:relative}
.links[data-astro-cid-dmqpwcec] a.active{color:var(--text)}
.mobile-menu a.active{color:var(--cyan)}
/* 6. skip link */
.skip-link{position:fixed;left:12px;top:-64px;z-index:1000;padding:10px 16px;border-radius:10px;background:var(--text);color:var(--bg);font-weight:600;font-size:14px;transition:top .2s}
.skip-link:focus{top:12px}
#content:focus{outline:none}
.fcol{font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--faint);margin:0 0 14px;font-weight:500;line-height:1.4}

/* footer: author LinkedIn links + group social links */
.cols a.au{display:inline-flex;align-items:center;gap:6px;width:max-content;max-width:100%}
.cols a.au .li{opacity:.55;flex:0 0 auto;transition:opacity .2s,color .2s}
.cols a.au:hover .li{opacity:1;color:#0A66C2}
:root:not([data-theme=light]) .cols a.au:hover .li{color:#4c9ee8}
.social{display:flex;gap:10px;margin-top:18px}
.social a{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;border:1px solid var(--border-strong);color:var(--muted);transition:color .2s,border-color .2s,background .2s}
.social a:hover{color:var(--text);border-color:var(--text);background:var(--surface-2)}
@media(pointer:coarse){.social a{width:44px;height:44px}}

/* ---------- smoother feel ---------- */
@font-face{font-family:"Poppins Fallback";src:local("Arial"),local("Helvetica Neue"),local("Helvetica");size-adjust:113.7%;ascent-override:92.3%;descent-override:30.8%;line-gap-override:8.8%}
[data-reveal]{transform:translateY(12px);transition:opacity .45s var(--md-ease-out),transform .45s var(--md-ease-out);transition-delay:calc(var(--delay, 0s) * .5)}
.theme-fade,.theme-fade *,.theme-fade *::before,.theme-fade *::after{transition:background-color .45s ease,color .45s ease,border-color .45s ease,fill .45s ease,stroke .45s ease,box-shadow .45s ease!important}
::view-transition-old(root),::view-transition-new(root){animation-duration:.45s;animation-timing-function:cubic-bezier(.4,0,.2,1)}
::view-transition-old(root){animation-name:md-theme-out}::view-transition-new(root){animation-name:md-theme-in}
@keyframes md-theme-out{to{opacity:0}}@keyframes md-theme-in{from{opacity:0}}
@media(prefers-reduced-motion:reduce){.theme-fade,.theme-fade *{transition:none!important}[data-reveal]{opacity:1!important;transform:none!important;transition:none!important}}

/* optical alignment: centre the logo (mark + wordmark x-height) with the nav link text */
.nav .brand{position:relative;top:-2px}
