/* race: honest playback speed on the HAC lane */
.lane{grid-template-columns:215px 1fr 90px!important}.lane-name span{white-space:nowrap}
.ff{display:inline-flex;align-items:center;gap:4px;margin-top:4px;width:max-content;font-style:normal;font-family:var(--font-mono);font-size:11.5px;color:var(--faint);padding:2px 8px;border-radius:999px;border:1px solid var(--border);opacity:0;transition:opacity .3s,color .3s,border-color .3s}
.ff b{font-weight:500;color:var(--muted);font-variant-numeric:tabular-nums;min-width:6.5ch;transition:color .3s}
.ff.on{opacity:1}
.ff.fast{color:var(--orange);border-color:color-mix(in srgb,var(--orange) 45%,transparent)}
.ff.fast b{color:var(--orange)}
@media(max-width:560px){.lane{grid-template-columns:1fr auto!important}}
.x-nary .x-bar{background:linear-gradient(90deg,var(--brand-cyan),var(--brand-violet))!important}

/* status pill: flash on each threshold crossing; keeps a live pulse once past a cluster node */
.x-chip{--ring:var(--brand-cyan);position:relative;transform-origin:left center}
.x-chip[data-l="1"]{--ring:var(--brand-violet)}
.x-chip[data-l="2"]{--ring:var(--brand-pink);color:var(--text)!important;border-color:color-mix(in srgb,var(--brand-pink) 55%,transparent)!important}
@keyframes x-ring{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--ring) 55%,transparent)}100%{box-shadow:0 0 0 12px color-mix(in srgb,var(--ring) 0%,transparent)}}
.x-chip[data-l="2"]:after{content:"";position:absolute;left:12px;top:50%;width:7px;height:7px;margin-top:-3.5px;border-radius:50%;background:var(--brand-pink);animation:x-ping 1.6s ease-out infinite;pointer-events:none}
@keyframes x-ping{0%{transform:scale(1);opacity:.7}80%,100%{transform:scale(3);opacity:0}}
.x-chip[data-l="2"]{animation:x-alert 1.6s ease-in-out infinite}
.x-chip[data-l="2"].pulse{animation:x-pulse .6s var(--md-ease-out),x-ring .9s ease-out,x-alert 1.6s ease-in-out .9s infinite}
@keyframes x-alert{50%{box-shadow:0 0 0 4px color-mix(in srgb,var(--brand-pink) 18%,transparent)}}
