/* problem cards: icon beside title; one grouped card on tablets/phones */
.p-head{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.p-head .x{flex:0 0 auto;width:34px;height:34px}.p-head .x svg{width:20px;height:20px}
